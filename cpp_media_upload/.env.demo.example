# Copy to .env.demo on the Mac. Use owner-configured SSH aliases and the
# consumer guest's reserved IPv4 address on the private libvirt network.
UBUNTU_LAPTOP_SSH=
PRODUCER_SSH=
CONSUMER_SSH=
CONSUMER_PRIVATE_IP=
PRODUCER_MACHINE_ID=
CONSUMER_MACHINE_ID=

# Full Git SHA built on the Ubuntu physical host and loaded into both guests.
IMAGE_REVISION=
GUI_BASE_URL=http://127.0.0.1:8080

GRPC_PORT=50051
HTTP_PORT=8080
OVERLOAD_GRPC_PORT=50052
OVERLOAD_HTTP_PORT=8081
PRODUCER_COUNT=3
CONSUMER_COUNT=2
QUEUE_CAPACITY=5
COMPRESS=on
MAX_UPLOAD_MB=128
MAX_INFLIGHT=8
FFMPEG_TIMEOUT_SEC=120
UPLOAD_DEADLINE_SEC=180

# Optional time budgets in seconds.
# BOOT_TIMEOUT_SEC=120
# DRAIN_TIMEOUT_SEC=90
# CONTAINER_STOP_TIMEOUT_SEC=45
# SHUTDOWN_TIMEOUT_SEC=90
# SCENARIO_TIMEOUT_SEC=180
